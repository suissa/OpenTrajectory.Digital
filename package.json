{
  "name": "@opentrajectory/digital",
  "version": "0.1.0",
  "description": "TypeScript SDK for semantic, causal, temporal execution tracing.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./streaming": {
      "types": "./dist/streaming.d.ts",
      "import": "./dist/streaming.js"
    },
    "./websocket": {
      "types": "./dist/websocket.d.ts",
      "import": "./dist/websocket.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test tests/*.test.ts",
    "example": "tsx examples/step-by-step.ts",
    "ci": "npm run check && npm run build && npm test && npm run example && npm run pack:check",
    "pack:check": "node scripts/verify-package.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "tracing",
    "observability",
    "opentelemetry",
    "causal",
    "temporal",
    "decorators"
  ],
  "license": "Unlicense",
  "repository": {
    "type": "git",
    "url": "https://github.com/suissa/OpenTrajectory.Digital.git"
  },
  "homepage": "https://github.com/suissa/OpenTrajectory.Digital#readme",
  "bugs": {
    "url": "https://github.com/suissa/OpenTrajectory.Digital/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "sideEffects": false
}
